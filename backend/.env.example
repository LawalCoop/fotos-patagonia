# === Backend — PRODUCCIÓN (PLANTILLA) ===
# Copiar a backend/.env EN EL SERVIDOR y completar los valores.
# El .env real NUNCA se sube al repo (tiene secretos).

# --- Entorno ---
ENVIRONMENT=production

# --- Base de datos (contenedor "db" del compose) ---
POSTGRES_USER=fotopatagonia
POSTGRES_PASSWORD=          # generar una contraseña fuerte NUEVA
POSTGRES_DB=fotopatagonia
POSTGRES_HOST=db

# --- Seguridad ---
SECRET_KEY=                 # generar nueva -> openssl rand -hex 32

# --- Storage de fotos (Cloudflare R2, compatible con S3) ---
S3_ENDPOINT_URL=            # https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_PUBLIC_URL=              # dominio propio cacheado para servir fotos (ver "presigned images")
S3_ACCESS_KEY_ID=           # del token de R2
S3_SECRET_ACCESS_KEY=       # del token de R2
S3_BUCKET_NAME=fotopatagonia
S3_REGION=auto
STORAGE_ALLOWED_ORIGINS=https://somosfotospatagonia.com

# --- Pagos (MercadoPago) ---
MERCADOPAGO_ACCESS_TOKEN=   # token de PRODUCCIÓN de la cuenta de la dueña
# Las URLs de éxito/error/webhook ya tienen default a somosfotospatagonia.com;
# solo cambiarlas si se usa otro dominio.

# --- Email (Resend) ---
RESEND_API_KEY=             # API key NUEVA de la cuenta de Resend
EMAIL_FROM=Fotos Patagonia <hola@somosfotospatagonia.com>

# --- URLs ---
FRONTEND_URL=https://somosfotospatagonia.com
