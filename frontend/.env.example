# === Frontend — PRODUCCIÓN (PLANTILLA) ===
# Copiar a frontend/.env EN EL SERVIDOR y completar.
# IMPORTANTE: las variables NEXT_PUBLIC_* NO van acá — se "queman" dentro de la
# imagen al buildear (se cargan como Variables del repo en GitHub Actions).
# Acá van solo las variables de RUNTIME del servidor Next (la ruta /api/contact).

# --- reCAPTCHA (verificación del captcha, lado servidor) ---
RECAPTCHA_SECRET_KEY=       # la mitad SECRETA del par de reCAPTCHA

# --- Email del formulario de contacto ---
# NOTA: se va a MIGRAR a Resend. Mientras siga EmailJS, completar:
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
